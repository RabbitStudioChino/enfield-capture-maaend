{
  "type": "object",
  "required": [
    "schema_version",
    "scene_id",
    "release_id",
    "world_frame",
    "roam_bounds_world",
    "spawn",
    "profiles",
    "chunks",
    "asset_index_uri",
    "asset_index_sha256",
    "character_asset_id",
    "camera",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "world.release/1.0"
    },
    "scene_id": {
      "$ref": "#/$defs/id"
    },
    "release_id": {
      "$ref": "#/$defs/id"
    },
    "world_frame": {
      "type": "object",
      "required": [
        "id",
        "handedness",
        "up_axis",
        "unit",
        "scale_status",
        "scale_reference"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "handedness": {
          "const": "right"
        },
        "up_axis": {
          "const": "+Y"
        },
        "unit": {
          "const": "meter"
        },
        "scale_status": {
          "enum": [
            "arbitrary",
            "estimated",
            "verified"
          ]
        },
        "scale_reference": {
          "type": "object",
          "required": [
            "method",
            "description"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "max_error_m": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "roam_bounds_world": {
      "$ref": "#/$defs/aabb"
    },
    "spawn": {
      "type": "object",
      "required": [
        "position",
        "rotation_xyzw"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation_xyzw": {
          "$ref": "#/$defs/quaternion"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mobile",
          "balanced",
          "high"
        ]
      },
      "contains": {
        "const": "mobile"
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chunk"
      },
      "minItems": 1
    },
    "asset_index_uri": {
      "$ref": "#/$defs/release_uri"
    },
    "character_asset_id": {
      "$ref": "#/$defs/id"
    },
    "camera": {
      "type": "object",
      "required": [
        "mode",
        "target_height_m",
        "distance_m",
        "yaw_degrees",
        "pitch_degrees",
        "vertical_fov_degrees",
        "near_m",
        "far_m"
      ],
      "properties": {
        "mode": {
          "const": "third_person"
        },
        "target_height_m": {
          "type": "number",
          "minimum": 0
        },
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw_degrees": {
          "type": "number"
        },
        "pitch_degrees": {
          "type": "number",
          "exclusiveMinimum": -90,
          "exclusiveMaximum": 90
        },
        "vertical_fov_degrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "near_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "far_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_kind",
        "input_batch_ids",
        "reconstruction_revision",
        "master_revision",
        "exporter_version",
        "description"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "synthetic_fixture",
            "reconstruction"
          ]
        },
        "input_batch_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reconstruction_revision": {
          "$ref": "#/$defs/id"
        },
        "master_revision": {
          "$ref": "#/$defs/id"
        },
        "exporter_version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endfield-world.invalid/contracts/world/1.0/world-release.schema.json",
  "title": "WorldRelease 1.0",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])",
      "minLength": 1
    },
    "release_uri": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "aabb": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "rotation_xyzw",
        "scale"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation_xyzw": {
          "$ref": "#/$defs/quaternion"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "lod": {
      "type": "object",
      "required": [
        "asset_id",
        "min_distance_m",
        "hysteresis_m"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "min_distance_m": {
          "type": "number",
          "minimum": 0
        },
        "hysteresis_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": [
        "id",
        "bounds_world",
        "transform",
        "render_variants",
        "collision_asset_id",
        "neighbors",
        "shared_dependencies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "bounds_world": {
          "$ref": "#/$defs/aabb"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "render_variants": {
          "type": "object",
          "required": [
            "mobile"
          ],
          "properties": {
            "mobile": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/lod"
              },
              "minItems": 1
            },
            "balanced": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/lod"
              },
              "minItems": 1
            },
            "high": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/lod"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "collision_asset_id": {
          "$ref": "#/$defs/id"
        },
        "neighbors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "shared_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    }
  }
}
