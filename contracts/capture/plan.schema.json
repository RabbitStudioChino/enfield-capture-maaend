{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.endfield.local/capture/1.0/plan.schema.json",
    "title": "Capture plan",
    "type": "object",
    "required": [
        "schema_version",
        "plan_id",
        "revision",
        "session_id",
        "region_id",
        "map_coordinates",
        "waypoints"
    ],
    "properties": {
        "schema_version": {
            "const": "capture.plan/1.0"
        },
        "plan_id": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
        },
        "revision": {
            "type": "integer",
            "minimum": 1
        },
        "session_id": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
        },
        "region_id": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
        },
        "map_coordinates": {
            "type": "object",
            "required": [
                "coordinate_frame_id",
                "unit",
                "axes",
                "heading_unit",
                "heading_convention",
                "scale_status"
            ],
            "properties": {
                "coordinate_frame_id": {
                    "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
                },
                "unit": {
                    "const": "map_pixel"
                },
                "axes": {
                    "const": "x_right_y_down"
                },
                "heading_unit": {
                    "const": "degree"
                },
                "heading_convention": {
                    "const": "clockwise_from_map_up"
                },
                "scale_status": {
                    "const": "arbitrary"
                }
            }
        },
        "waypoints": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "waypoint_id",
                    "segment_id",
                    "position_xy",
                    "camera_intent"
                ],
                "properties": {
                    "waypoint_id": {
                        "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
                    },
                    "segment_id": {
                        "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
                    },
                    "position_xy": {
                        "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/xy"
                    },
                    "camera_intent": {
                        "type": "object",
                        "required": [
                            "yaw_degrees",
                            "pitch_degrees",
                            "settle_required"
                        ],
                        "properties": {
                            "yaw_degrees": {
                                "anyOf": [
                                    {
                                        "type": "number",
                                        "minimum": 0,
                                        "exclusiveMaximum": 360
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "pitch_degrees": {
                                "anyOf": [
                                    {
                                        "type": "number",
                                        "minimum": -90,
                                        "maximum": 90
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "settle_required": {
                                "type": "boolean"
                            }
                        }
                    },
                    "target_deck_y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                    },
                    "auto_plan_waypoint_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "candidate_id": {
                        "type": "string",
                        "pattern": "^candidate-[0-9a-f]{48}$"
                    },
                    "rescan_action_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "rescan_issue_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    }
                }
            },
            "minItems": 1
        },
        "auto_plan_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        }
    }
}
