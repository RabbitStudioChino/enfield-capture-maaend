{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.endfield.local/capture/1.0/batch.schema.json",
    "title": "Capture batch",
    "type": "object",
    "required": [
        "schema_version",
        "batch_id",
        "session_id",
        "region_id",
        "input_revision",
        "status",
        "frame_ids",
        "files",
        "frames_uri",
        "session_identity",
        "calibration_groups"
    ],
    "properties": {
        "schema_version": {
            "const": "capture.batch/1.0"
        },
        "batch_id": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
        },
        "session_id": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
        },
        "region_id": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
        },
        "input_revision": {
            "type": "integer",
            "minimum": 1
        },
        "status": {
            "const": "committed"
        },
        "frame_ids": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/id"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "files": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/file"
            },
            "minItems": 2
        },
        "frames_uri": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/text"
        },
        "session_identity": {
            "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/session_identity"
        },
        "calibration_groups": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/calibration"
            }
        }
    }
}
