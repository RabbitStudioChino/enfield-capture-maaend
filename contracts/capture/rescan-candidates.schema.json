{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.endfield.local/capture/1.0/rescan-candidates.schema.json",
    "type": "object",
    "required": [
        "schema_version",
        "auto_plan_id",
        "region_id",
        "resources_sha256",
        "candidates"
    ],
    "properties": {
        "schema_version": {
            "const": "capture.rescan-candidates/1.0"
        },
        "auto_plan_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "region_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "resources_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
                "type": "object",
                "required": [
                    "candidate_id",
                    "position_xy",
                    "target_deck_y",
                    "source_waypoint_ids"
                ],
                "properties": {
                    "candidate_id": {
                        "type": "string",
                        "pattern": "^candidate-[0-9a-f]{48}$"
                    },
                    "position_xy": {
                        "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/xy"
                    },
                    "target_deck_y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                    },
                    "source_waypoint_ids": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
