{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.endfield.local/capture/1.0/auto-plan.schema.json",
    "type": "object",
    "required": [
        "schema_version",
        "plan_id",
        "created_utc",
        "region",
        "map_coordinates",
        "selection",
        "waypoints",
        "resources",
        "runtime_resources",
        "coverage"
    ],
    "properties": {
        "schema_version": {
            "const": "capture.auto-plan/1.0"
        },
        "plan_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "created_utc": {
            "type": "string",
            "format": "date-time"
        },
        "region": {
            "type": "object"
        },
        "map_coordinates": {
            "$ref": "https://schemas.endfield.local/capture/1.0/plan.schema.json#/properties/map_coordinates"
        },
        "selection": {
            "type": "object"
        },
        "waypoints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
                "type": "object",
                "required": [
                    "waypoint_id",
                    "segment_id",
                    "position_xy",
                    "target_deck_y",
                    "yaw_degrees",
                    "pitch_degrees",
                    "sample_index",
                    "view_index"
                ],
                "properties": {
                    "waypoint_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "segment_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "position_xy": {
                        "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/xy"
                    },
                    "target_deck_y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                    },
                    "yaw_degrees": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMaximum": 360
                    },
                    "pitch_degrees": {
                        "type": "null"
                    },
                    "sample_index": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "view_index": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "candidate_id": {
                        "type": "string",
                        "pattern": "^candidate-[0-9a-f]{48}$"
                    },
                    "rescan_action_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "rescan_issue_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    }
                },
                "additionalProperties": false
            }
        },
        "resources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/file"
            }
        },
        "runtime_resources": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.endfield.local/capture/1.0/common.schema.json#/$defs/file"
            }
        },
        "coverage": {
            "type": "object"
        },
        "rescan_request": {
            "type": "object",
            "required": [
                "schema_version",
                "request_id",
                "project_id",
                "round_id",
                "reconstruction_revision",
                "region_id",
                "source",
                "budget",
                "issues",
                "actions"
            ],
            "properties": {
                "schema_version": {
                    "const": "reconstruction.rescan/2.0"
                },
                "request_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "project_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "round_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "reconstruction_revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "region_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "source": {
                    "type": "object",
                    "required": [
                        "bundle_sha256",
                        "auto_plan_sha256",
                        "catalog_sha256",
                        "resources_sha256"
                    ],
                    "properties": {
                        "bundle_sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                        },
                        "auto_plan_sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                        },
                        "catalog_sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                        },
                        "resources_sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                        }
                    },
                    "additionalProperties": false
                },
                "budget": {
                    "type": "object",
                    "required": [
                        "max_actions"
                    ],
                    "properties": {
                        "max_actions": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 128
                        }
                    },
                    "additionalProperties": false
                },
                "issues": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                        "type": "object",
                        "required": [
                            "issue_id",
                            "description",
                            "evidence"
                        ],
                        "properties": {
                            "issue_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                            },
                            "description": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2000
                            },
                            "evidence": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 128,
                                "uniqueItems": true,
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "session_id",
                                        "frame_id"
                                    ],
                                    "properties": {
                                        "session_id": {
                                            "type": "string",
                                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                                        },
                                        "frame_id": {
                                            "type": "string",
                                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                        "type": "object",
                        "required": [
                            "action_id",
                            "issue_id",
                            "target_candidate_id",
                            "heading_degrees",
                            "reason"
                        ],
                        "properties": {
                            "action_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                            },
                            "issue_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                            },
                            "target_candidate_id": {
                                "type": "string",
                                "pattern": "^candidate-[0-9a-f]{48}$"
                            },
                            "heading_degrees": {
                                "type": "number",
                                "minimum": 0,
                                "exclusiveMaximum": 360
                            },
                            "reason": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2000
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "rescan_source": {
            "type": "object",
            "required": [
                "review_uri",
                "bundle_uri"
            ],
            "properties": {
                "review_uri": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                },
                "bundle_uri": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
